# Bật /swagger-ui.html và /v3/api-docs ở prod (mặc định tắt).
SWAGGER_ENABLED=false
# CD truyền APP_IMAGE qua biến môi trường. Chỉ cần đặt khi chạy tay:
# APP_IMAGE=ghcr.io/<owner>/do-something:latest
