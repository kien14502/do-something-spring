POSTGRES_USER=do_something
# Required: set distinct strong passwords before starting.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Cổng loopback publish cho app; reverse proxy trỏ vào đây.
